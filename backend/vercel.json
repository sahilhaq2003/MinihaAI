{
    "version": 2,
    "installCommand": "npm install && npm install mysql2 --save",
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/api"
        }
    ],
    "functions": {
        "api/index.js": {
            "maxDuration": 60,
            "includeFiles": "node_modules/mysql2/**"
        }
    }
}